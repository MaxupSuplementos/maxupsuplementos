# La página y el service worker siempre se revalidan para recibir cambios.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate

# app.js y styles.css usan una versión en la URL. Cloudflare puede conservar
# cada versión durante un año sin impedir que una publicación nueva aparezca.
/app.js
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/products_compact.js
  Cache-Control: public, max-age=3600, must-revalidate

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Encabezados seguros que no interfieren con pagos, WhatsApp ni Apps Script.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# La dirección temporal se usa para probar; Google debe indexar solo el dominio.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex
